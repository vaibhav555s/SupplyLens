# === Supply Chain X-Ray Environment ===

# UN Comtrade API (free: 500 calls/day)
# Register at: https://comtradedeveloper.un.org
COMTRADE_API_KEY=

# OpenCorporates API (free: 500 req/day)
# Register at: https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_KEY=

# Groq API (LLM fallback for entity resolution)
# Register at: https://console.groq.com/keys
GROQ_API_KEY=

# Redis (optional — falls back to in-memory cache)
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
NODE_ENV=development
